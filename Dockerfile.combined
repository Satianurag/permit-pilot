FROM node:22-alpine AS web-build
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
ENV VITE_API_BASE=/api
RUN npm run build

FROM python:3.12-slim
WORKDIR /app
COPY packages/permit_pilot_core /app/packages/permit_pilot_core
COPY services/api /app/services/api
ENV PIP_DEFAULT_TIMEOUT=120
RUN pip install --no-cache-dir --retries 5 -e /app/packages/permit_pilot_core -e /app/services/api

COPY --from=web-build /app/dist /app/static

ENV PORT=8080
ENV STATIC_ROOT=/app/static
EXPOSE 8080

CMD ["uvicorn", "permit_pilot_api.main:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
