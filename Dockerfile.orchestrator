FROM python:3.12-slim

WORKDIR /app
COPY packages/permit_pilot_core /app/packages/permit_pilot_core
COPY services/orchestrator /app/services/orchestrator

RUN pip install --no-cache-dir -e /app/packages/permit_pilot_core -e /app/services/orchestrator

ENV PORT=8080
ENV GOOGLE_CLOUD_PROJECT=gen-lang-client-0233250350
ENV GOOGLE_CLOUD_LOCATION=us-central1
ENV GOOGLE_GENAI_USE_VERTEXAI=true

WORKDIR /app/services/orchestrator
EXPOSE 8080

CMD ["adk", "web", "src/permit_pilot/agents", "--host", "0.0.0.0", "--port", "8080"]
