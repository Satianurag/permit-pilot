FROM python:3.12-slim
WORKDIR /app
COPY packages/permit_pilot_core /app/packages/permit_pilot_core
COPY services/mcp-tools /app/services/mcp-tools
ENV PIP_DEFAULT_TIMEOUT=120
RUN pip install --no-cache-dir --retries 5 -e /app/packages/permit_pilot_core \
    && pip install --no-cache-dir --retries 5 -e /app/services/mcp-tools
ENV PORT=8080
EXPOSE 8080
CMD ["uvicorn", "permit_pilot_mcp.server:app", "--host", "0.0.0.0", "--port", "8080", "--proxy-headers", "--forwarded-allow-ips", "*"]
